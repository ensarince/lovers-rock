# 1. Use a lightweight Linux base
FROM alpine:latest

# 2. Define the PocketBase version
ARG PB_VERSION=0.26.5

# 3. Install necessary tools to download and unzip
RUN apk add --no-cache \
    ca-certificates \
    unzip \
    wget \
    bash

# 4. Download the Linux version of PocketBase (NOT the .exe)
RUN wget https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip \
    && unzip pocketbase_${PB_VERSION}_linux_amd64.zip -d /pb/

# 5. Copy your local migrations and hooks into the container
# Hooks live at /pb/pb_hooks in the image (separate from the Railway volume).
# The CMD copies them into /pb/pb_data/pb_hooks at startup so PocketBase finds them.
COPY ./pb_migrations /pb/pb_migrations
COPY ./pb_hooks /pb/pb_hooks

# 6. Write the startup script inline (avoids Windows CRLF line-ending issues)
RUN printf '#!/bin/sh\nmkdir -p /pb/pb_data/pb_hooks\ncp -rf /pb/pb_hooks/. /pb/pb_data/pb_hooks/\nexec /pb/pocketbase serve --http=0.0.0.0:8080 --dir=/pb/pb_data\n' > /pb/start.sh \
    && chmod +x /pb/start.sh

# 7. Expose the port Railway uses
EXPOSE 8080

# 8. Start via script that syncs hooks then launches PocketBase
CMD ["/pb/start.sh"]
